{
  "name": "ztemate",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "go run github.com/egoist/mygo/cmd/mygo dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build": "go run github.com/egoist/mygo/cmd/mygo build",
    "build:mac": "bash scripts/build-mac.sh darwin/arm64",
    "build:universal": "bash scripts/build-mac.sh darwin/universal",
    "test": "go test ./internal/..."
  },
  "dependencies": {
    "vue": "3.5.24",
    "lucide-vue-next": "0.468.0",
    "mygo-runtime": "0.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vue-tsc": "3.1.4",
    "mygo-cli": "0.8.3",
    "@tailwindcss/vite": "4.1.17",
    "tailwindcss": "4.1.17"
  }
}
